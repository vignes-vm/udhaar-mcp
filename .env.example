# HTTP port for the MCP/Express server
PORT=

# AWS region for Bedrock Runtime calls
AWS_REGION=

# Bedrock model ID used for voice/ledger assistance
BEDROCK_MODEL_ID=

# If set, POST/GET/DELETE /mcp require "Authorization: Bearer <this value>" (401 otherwise). /health stays open.
UDHAAR_API_KEY=

# Set to "true" to disable Bedrock calls (e.g. offline/dev/demo mode)
UDHAAR_DISABLE_BEDROCK=

# Path to the local JSON data file used as the ledger store
UDHAAR_DATA_FILE=
